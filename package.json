{
  "name": "lazydsh",
  "version": "0.2.17",
  "description": "A lazier terminal UI for DeepSeek Harness.",
  "keywords": [
    "agent",
    "cli",
    "deepseek",
    "dsh",
    "harness",
    "tui"
  ],
  "homepage": "https://github.com/nuskey8/lazydsh#readme",
  "bugs": {
    "url": "https://github.com/nuskey8/lazydsh/issues"
  },
  "license": "MIT",
  "author": "nuskey8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuskey8/lazydsh.git"
  },
  "bin": {
    "dspi": "dist/cli.mjs",
    "dspio": "dist/cli.mjs",
    "lazydsh": "dist/cli.mjs"
  },
  "files": [
    "assets",
    "dist",
    "README.md",
    "README.ja.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/plugin.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "vp check && vp test run",
    "start": "node dist/cli.mjs",
    "demo": "node scripts/demo.ts",
    "build": "vp pack",
    "postbuild": "node -e \"const {copyFileSync,mkdirSync,readdirSync}=require('fs');const {resolve}=require('path');const srcDir=resolve('src/interactive-mode/theme');const destDir=resolve('dist');mkdirSync(destDir,{recursive:true});for(const file of readdirSync(srcDir)){if(file.endsWith('.json')){copyFileSync(resolve(srcDir,file),resolve(destDir,file));console.log('copied',file);}}\"",
    "check": "vp check",
    "test": "vp test run",
    "prepack": "vp pack",
    "generate-ofm-kilo-models": "node scripts/generate-ofm-kilo-models.mjs"
  },
  "dependencies": {
    "@code-yeongyu/senpi": "^2026.11.21-2",
